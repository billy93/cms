																	<th style="width: 18%">Sub Header</th>
																	<th style="width: 10%">Title 1</th>
																	<th style="width: 10%">Title 2</th>
																	<th style="width: 10%">Title 3</th>
																	<th style="width: 10%">Price</th>
																	<th style="width: 14%">Amount</th>
																	<th style="width: 10%"></th>
															</tr>
													</thead>
													<tbody id="products_services_body_e">
													</tbody>
													<tfoot>
															<tr>
																	<th colspan="6" class="text-end">Total</th>
																	<th><input type="text" class="form-control" id="total_amount_e" readonly></th>
																	<th></th>
															</tr>
													</tfoot>
											</table>
									</div>
									<button type="button" class="btn btn-sm btn-success" id="add_row_btn_e" style="margin-top: 12px;"><i class="ti ti-plus"></i> Add Row</button>
							</div>
					</div>
					<div class="mb-3">
							<label>Management Fee</label>
							<div class="input-group mb-2">
									<input type="number" class="form-control number-input no-default" name="management_fee_value_e" id="management_fee_value_e" placeholder="Nominal">
									<span class="input-group-text">atau</span>
									<input type="number" class="form-control number-input no-default" name="management_fee_percent_e" id="management_fee_percent_e" placeholder="%">
									<span class="input-group-text">%</span>
							</div>
							<small class="text-muted">Manual Entry: bisa dengan menentukan prosentasi atau menentukan nominal nya</small>
					</div>
					<div class="mb-3">
							<label>Sales Amount</label>
							<input type="text" class="form-control" id="sales_amount_e" readonly>
					</div>
					<div class="mb-3">
							<label>VAT</label>
							<select class="form-select" name="vat_percent_e" id="vat_percent_e">
									<option value="1" selected>1%</option>
									<option value="11">11%</option>
							</select>
							<small class="text-muted">Manual - Pilihan 1% atau 11%</small>
					</div>
					<div class="mb-3">
							<label>VAT Amount</label>
							<input type="text" class="form-control" id="vat_amount_e" readonly>
					</div>
					<div class="mb-3">
							<label>Invoice Amount</label>
							<input type="text" class="form-control" id="invoice_amount_e" readonly>
					</div>
					<div class="mt-3" id="note_e">
							<span class="text-danger"><b>Note</b><br>
							<i>1. BOQ Type E memberikan keleluasaan untuk menentukan baik header maupun sub header dari produk dan jasa yang dijual, demikian juga dengan rincian kalkulasi harga nya<br>
							2. One Header can consists of many Sub Header</i></span>
					</div>
				</div>
				<div class="d-flex align-items-center justify-content-end mt-4">
					<a href="#" class="btn btn-light me-2" data-bs-dismiss="offcanvas">Cancel</a>
					<button type="submit" class="btn btn-primary">Create</button>
				</div>
			</form>
			<script>
			document.addEventListener('DOMContentLoaded', () => {	
				// Element 
				const FORM = document.getElementById('addBOQ');
				const BOQ_TYPE_EL = document.getElementById("boq_type");
				const addBoqBtn = document.getElementById("c_boq_add");
				const closeAddBoqBtn = document.getElementById("close_boq_add");
				
				let PRODUCTS = [];
				let isFetching = false;


				const ERRORS = {
					a: {},
					b: {},
					c: {},
					d: {},
				}

				
				// BOQ Type
				const TYPES = ['a', 'b', 'c', 'd'];
				let BOQ_TYPE = 'A';
				let C_ROW_COUNT = 0;
				let C_ROW_ARR = [] 
				let D_ROW_COUNT = 0;
				let D_ROW_ARR = [] 

				const COMMON_FIELDS_IDS = [
					"#management_fee_percent_",
					"#management_fee_value_",
					"#vat_percent_",
				]
				.flatMap(key => TYPES.map(type => key + type)) 
				.concat([
					"#basic_price_a",
				]);
				
				addBoqBtn.addEventListener("click", function (e) {
					isFetching = true;
					fetch("/products/all", {
							method: "GET",
							headers: {
									"Content-Type": "application/json",
									"Accept": "application/json",
									"X-CSRF-TOKEN": document.querySelector('meta[name="csrf-token"]').getAttribute("content")
							},
					})
					.then(response => {
							if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
							return response.json(); 
					})
					.then(res => {
							PRODUCTS = res.data; 
							console.log("Response dari backend:", PRODUCTS);
					})
					.catch(err => {
							console.error("Fetch products error:", err);
					})
					.finally(() => isFetching = false)
				});

				closeAddBoqBtn.addEventListener("click", function (e) {
					resetErrorFields();
					resetFields();
					BOQ_TYPE_EL.value = "A";
					const event = new Event("change", { bubbles: true });
					BOQ_TYPE_EL.dispatchEvent(event);
				});

				function resetErrorFields() {
					const suffix = BOQ_TYPE.toLowerCase();
					const errKeys = Object.keys(ERRORS[suffix]);
					if(errKeys.length) {
						errKeys.forEach(v => {
							const el = document.getElementById(v);
							if (el) {
								el.innerText = "";
								el.style.display = "none";
							}
						});
					}		
					TYPES.forEach(v => ERRORS[v] = {});
				}

				function validateBOQ() {
					resetErrorFields();
					const suffix = BOQ_TYPE.toLowerCase(); // 'a', 'b', 'c', 'd'
					const errorObj = {};
					const payload = {};

					
					const description = document.getElementById(`description_${suffix}`);
					if(!description || !description.value.trim()) {
						errorObj[`description_${suffix}_error`] = "Description is required." 
					} else {
						payload.description = description.value.trim(); 
					}
					
					const basicPrice = document.getElementById(`basic_price_${suffix}`);
					if(BOQ_TYPE === "A") {
						if(!basicPrice || !parseFloat(basicPrice.value)) {
							errorObj[`basic_price_${suffix}_error`] = "Basic price is required." 
						} else {
							payload.total_amount_items = parseFloat(basicPrice.value);
						}
					} else if (BOQ_TYPE === "B") {
						payload.items = [];
						const adultQty = document.getElementById('qty_adult');
						const childQty = document.getElementById('qty_child');
						const infantQty = document.getElementById('qty_infant');
						const adultPrice = document.getElementById('price_adult');
						const childPrice = document.getElementById('price_child');
						const infantPrice = document.getElementById('price_infant');

						if (adultPrice && parseFloat(adultPrice.value)) {
							if (!adultQty || !parseInt(adultQty.value)) {
								errorObj[`qty_adult_error`] = "Adult qty is required." 
							} else {
								payload.items.push({
									subheader: "Adult",
									unit_price: parseFloat(adultPrice.value),
									unit_count: parseInt(adultQty.value)
								});
							}
						}

						if (childPrice && parseFloat(childPrice.value)) {
							if (!childQty || !parseInt(childQty.value)) {
								errorObj[`qty_child_error`] = "Child qty is required." 
							} else {
								payload.items.push({
									subheader: "Child",
									unit_price: parseFloat(childPrice.value),
									unit_count: parseInt(childQty.value)
								});
							}
						}

						if (infantPrice && parseFloat(infantPrice.value)) {
							if (!infantQty || !parseInt(infantQty.value)) {
								errorObj[`qty_infant_error`] = "Infant qty is required." 
							} else {
								payload.items.push({
									subheader: "Infant",
									unit_price: parseFloat(infantPrice.value),
									unit_count: parseInt(infantQty.value)
								});
							}
						}

						if(!payload.items.length) {
							errorObj[`items_${suffix}_error`] = "Required at least one category item specified." 
						}
					}
					
					const managementFeeValueEl = document.getElementById(`management_fee_value_${suffix}`);
					const managementFeePercentEl = document.getElementById(`management_fee_percent_${suffix}`);
					const vatPercentEl = document.getElementById(`vat_percent_${suffix}`);
					let managementFee = 0;
					let managementFeeType = "percent";

					if (managementFeeValueEl && parseFloat(managementFeeValueEl.value)) {
						management_fee = parseFloat(managementFeeValueEl.value);
						managementFeeType = "nominal";
					} 
					if (managementFeePercentEl && parseFloat(managementFeePercentEl.value)) {
						management_fee = parseFloat(managementFeePercentEl.value);
					} 
					if (vatPercentEl && ["1", "11"].includes(vatPercentEl.value)) {
						payload.vat_Rate = parseInt(vatPercentEl.value);
					} else {
						errorObj[`vat_percent_${suffix}_error`] = "Invalid VAT rate." 
					}
					
					payload.management_fee = managementFee;
					payload.management_fee_type = managementFeeType;
					
					ERRORS[suffix] = {...errorObj}
					return payload;
				}

				FORM.addEventListener("submit", (e) => {
					e.preventDefault();
					 
					const suffix = BOQ_TYPE.toLowerCase();
					const formType = `type-${suffix}`;
					
					const payload = validateBOQ();
					console.log(ERRORS);
					const errKeys = Object.keys(ERRORS[suffix]);
					if(errKeys.length) {
						errKeys.forEach(v => {
							const el = document.getElementById(v);
							if (el) {
								el.innerText = ERRORS[suffix][v];
								el.style.display = "block";
							}
						});
						return;  
					}				
					console.log("PAYLOAD", payload); 
					
					
				});
				
				// Helper 
				function formatRupiah(angka) {
					if (angka === null || angka === undefined || angka === '') return '';
					
					const num = Number(angka);
					if (isNaN(num)) return '';

					// Cek apakah ada desimal
					const hasDecimal = angka.toString().includes('.') || angka.toString().includes(',');
					return num.toLocaleString('id-ID', {
						minimumFractionDigits: hasDecimal ? 2 : 0,
						maximumFractionDigits: hasDecimal ? 2 : 0
					});
				}
	
				function getManagementFee(basic, percent, nominal) {
					if (percent) return basic * (percent / 100);
					if (nominal) return nominal;
					return 0;
				}
			


				BOQ_TYPE_EL?.addEventListener('change', (e) => {
					const { value } = e.target;
					resetErrorFields();
					resetFields(); // Reset current form inputs on current type 
					BOQ_TYPE = value;

					// Show & Hide Form
					TYPES.filter(v => v !== value.toLowerCase()).forEach((suffix) => {
				    document.getElementById(`form_type_${suffix}`).style.display = 'none';
					});
					document.getElementById(`form_type_${value.toLowerCase()}`).style.display = '';

					if (value === 'C') {
						const tbody = document.querySelector("#form_type_c #products_services_body_c");
						tbody.innerHTML = ""; 
						tbody.appendChild(createRow()); 
					} else if (value === 'D') {
						const tbody = document.querySelector("#form_type_d #products_services_body_d");
						tbody.innerHTML = ""; 
						tbody.appendChild(createRow()); 
					}
				});

				// Type A listeners
				

				// Title Key select event to disable/enable Title Value input
				document.addEventListener("change", (e) => {
					const target = e.target;
					
					if (target.matches(".title-select")) {
						const input = target.parentElement.querySelector(".title-value-input"); 
						if (input) {
							if (target.value === "") {
								input.disabled = true;
								input.value = ""; // kosongin kalau belum pilih
							} else {
								input.disabled = false;
								if (input.value === "") input.value = 0; // default 0
							}
						}
					// --- [4] Type C Subheader Switch Input to Select ---
					} else if (target.matches(".sub-header-select")) {
						console.log(target);
						
						target.nextElementSibling.value = "";
					} 


				});

				document.addEventListener("input", (e) => {
					const target = e.target;
											
					if (target.matches('input[type="text"].number-input')) {
						let val = target.value;

						if (target.classList.contains("no-decimal")) {
							// Hanya digit, hapus semua non-digit
							val = val.replace(/\D/g, ""); 
							// Prevent leading zero, kecuali "0"
							val = val.replace(/^0+(?=\d)/, "");
						} else {
							// Boleh desimal, hapus selain angka + titik
							val = val.replace(/[^0-9.]/g, "");   
							// Hanya satu titik
							val = val.replace(/(\..*)\./g, "$1");
							// Jika input hanya titik, ubah jadi "0."
							if(val === ".") val = "0."; 
							// Prevent leading zero sebelum digit (contoh: 012 -> 12, tapi 0.5 tetap 0.5)
							val = val.replace(/^0+([1-9])/, "$1");
						}

						target.value = val;
					}

					// --- [2] Auto calculate common inputs ---
					if (
						target.matches(COMMON_FIELDS_IDS)
					) {
						if (target.id.startsWith("management_fee_percent_")) {
							const feeValue = document.getElementById(`management_fee_value_${target.id.charAt(target.id.length - 1)}`);
							if (feeValue) feeValue.value = "";
						} else if (target.id.startsWith("management_fee_value_")) {
							const feePercent = document.getElementById(`management_fee_percent_${target.id.charAt(target.id.length - 1)}`);
							if (feePercent) feePercent.value = "";
						}

						recalculateInputs();
					}

					// --- [3] Auto calculate specific type B inputs  ---
					if (
						target.matches(
							"#qty_adult, #price_adult, #qty_child, #price_child, #qty_infant, #price_infant, .title-value-input, .amount-input"
						)
					) {
						recalculateInputs();
					}

					// --- [4] Type C Subheader Switch Input to Select ---
					if (
						target.matches(".sub-header-input")
					) {
						target.previousElementSibling.value = "";
					} 
				});

				document.addEventListener("blur", (e) => {
					const target = e.target;
					
					if (target.matches('input[type="text"].number-input:not(.no-default)')) {
						if (target.value.trim() === "") {
								target.value = "0";
						}
					}
				}, true); // true supaya pakai capturing, jadi bisa tangkap blur di semua input

				document.addEventListener("click", (e) => {
					if (e.target.matches("#add_row_btn_c")) {
						document.querySelector("#form_type_c #products_services_body_c").appendChild(createRow())
					} else if (e.target.matches("#add_row_btn_d")) {
						document.querySelector("#form_type_d #products_services_body_d").appendChild(createRow())
					};
				});

				//  Create Row C
				const HEADERS = [
				    'Accommodation','Activities , Outdoor','Airport Assistance','Air tickets','Documentation','Entrance ticket - Shows and Entertainment','Entrance ticket - Places of interest','Excursion','F&B Restaurants','Front of House','Goodie Bags','Gratitudes','Insurance','Land transportation','Lighting','Manpower','MC','Media Relation','Meeting and Conference Kits','Meeting Package','Merchandise','Multimedia','Paramedic and First Aids','Rail tickets','Sales and Promotion Materials','Security Service & Fire','Software','Sound System','Speaker','Stationery','Streaming','Survey','Talents','Team Building','Travel Documents','Traveling kits','Venue'
				];
				const TITLES = [
				    'Quantity','Number of nights','Number of rooms','Number of hours','Number of days','Number of items','Number of participants','Number of unit','Number of package','Unit Price'
				];
				function createRow() {
					const suffix = BOQ_TYPE.toLowerCase();  
					let id, rowId;
					console.log(">>>>>>>>", suffix, PRODUCTS);
					
					if (BOQ_TYPE === "C") {
						id = ++C_ROW_COUNT; 
						rowId = `row_${suffix}_${C_ROW_COUNT}`;
						C_ROW_ARR = [...new Set([...C_ROW_ARR, C_ROW_COUNT])];
					} else if (BOQ_TYPE === "D") {
						id = ++D_ROW_COUNT; 
						rowId = `row_${suffix}_${D_ROW_COUNT}`;
						D_ROW_ARR = [...new Set([...D_ROW_ARR, D_ROW_COUNT])];
					} 
					
					const tr = document.createElement('tr');
					let subheader = `<td><input id="subheader_${suffix}_${id}" type="text" class="form-control" placeholder="Sub Header"></td>`
					if(BOQ_TYPE === "C") {
						subheader = `
							<td>	
								<select id="subheader_select_${suffix}_${id}" class="form-select sub-header-select">
									<option value="">-- Select Header --</option>
									${PRODUCTS.map(t => `<option value="${t.id}">${t.name}</option>`).join('')}
								</select>
								<input id="subheader_${suffix}_${id}" type="text" class="form-control sub-header-input mt-1" placeholder="Sub Header">
							</td>
						`;
					}
					tr.id = rowId;
					tr.innerHTML = `
							<td>
								<select id="header_${suffix}_${id}" class="form-select header-select">
									<option value="">-- Select Header --</option>
									${HEADERS.map(h => `<option value="${h}">${h}</option>`).join('')}
								</select>
							</td>
							${subheader}
							<td>
								<select id="title_1_key_${suffix}_${id}" class="form-select title-select">
									<option value="">-- Select Title1 --</option>
									${TITLES.map(t => `<option value="${t}">${t}</option>`).join('')}
								</select>
								<input id="title_1_value_${suffix}_${id}" type="text" class="form-control number-input no-decimal title-value-input mt-1 no-decimal" placeholder="Value" disabled>
							</td>
							<td>
								<select id="title_2_key_${suffix}_${id}" class="form-select title-select">
									<option value="">-- Select Title2 --</option>
									${TITLES.map(t => `<option value="${t}">${t}</option>`).join('')}
								</select>
								<input id="title_2_value_${suffix}_${id}" type="text" class="form-control number-input no-decimal title-value-input mt-1 no-decimal" placeholder="Value" disabled>
							</td>
							<td>
								<select id="title_3_key_${suffix}_${id}" class="form-select title-select">
									<option value="">-- Select Title3 --</option>
									${TITLES.map(t => `<option value="${t}">${t}</option>`).join('')}
								</select>
								<input id="title_3_value_${suffix}_${id}" type="text" class="form-control number-input no-decimal title-value-input mt-1 no-decimal" placeholder="Value" disabled>
							</td>
							<td>
								<select id="title_4_key_${suffix}_${id}" class="form-select title-select">
									<option value="">-- Select Title4 --</option>
									${TITLES.map(t => `<option value="${t}">${t}</option>`).join('')}
								</select>
								<input id="title_4_value_${suffix}_${id}" type="text" class="form-control number-input no-decimal title-value-input mt-1 no-decimal" placeholder="Value" disabled>
							</td>
							<td><input id="amount_${suffix}_${id}" type="text" class="form-control number-input no-decimal amount-input" min="0" value="0"></td>
							<td><input id="subtotal_${suffix}_${id}" type="text" class="form-control" value="0" readonly></td>
							<td class="actions"><button type="button" class="btn btn-sm btn-danger remove-row-btn"><i class="ti ti-trash"></i></button></td>
					`;
					tr.querySelector(".remove-row-btn").addEventListener("click", () => {
						tr.remove();
						if (suffix == "c") {
							C_ROW_ARR = C_ROW_ARR.filter(v => v !== id);
						} else if (suffix == "d") {
							D_ROW_ARR = D_ROW_ARR.filter(v => v !== id);
						}
						recalculateInputs(); 
					});
					return tr;
				}
				 
				function recalculateInputs() {
					let basic = 0;
					const suffix = BOQ_TYPE.toLowerCase();
					
					if (BOQ_TYPE === 'A') {
						basic = parseFloat(document.getElementById('basic_price_a').value) || 0;
					} else if (BOQ_TYPE === 'B') {
						const adult = parseInt(document.getElementById('qty_adult').value || 0) * parseFloat(document.getElementById('price_adult').value || 0);
						const child = parseInt(document.getElementById('qty_child').value || 0) * parseFloat(document.getElementById('price_child').value || 0);
						const infant = parseInt(document.getElementById('qty_infant').value || 0) * parseFloat(document.getElementById('price_infant').value || 0);
						document.getElementById('subtotal_adult').value = formatRupiah(adult);
						document.getElementById('subtotal_child').value = formatRupiah(child);
						document.getElementById('subtotal_infant').value = formatRupiah(infant);
						basic = adult + child + infant;
					} else if (BOQ_TYPE === 'C' || BOQ_TYPE === 'D') {
						const subtotalArr = [];
						const arr = BOQ_TYPE === 'C' ? [...C_ROW_ARR] : [...D_ROW_ARR];
						console.log(BOQ_TYPE, C_ROW_COUNT, C_ROW_ARR, D_ROW_COUNT, D_ROW_ARR)
						for (let i = 0; i <= arr.length - 1; i++) {
							const idx = arr[i];
							const t1El = document.getElementById(`title_1_value_${suffix}_${idx}`);
							const t2El = document.getElementById(`title_2_value_${suffix}_${idx}`);
							const t3El = document.getElementById(`title_3_value_${suffix}_${idx}`);
							const t4El = document.getElementById(`title_4_value_${suffix}_${idx}`);
							const amountEl = document.getElementById(`amount_${suffix}_${idx}`);
							const subtotalEl = document.getElementById(`subtotal_${suffix}_${idx}`);
							
							const titles = [t1El, t2El, t3El, t4El].map(el => parseInt(el?.value) || 0);
							const amount = parseFloat(amountEl?.value) || 0;

							// cek kalau semua title = 0
							const isNoMultiplier = titles.every(v => v === 0);

							// kalau kosong dianggap 1 biar multipliernya jalan
							const subtotal = isNoMultiplier ? 0 : titles.reduce((acc, v) => acc * (v || 1), 1) * amount;
							subtotalArr.push(subtotal);

							if (subtotalEl) {
								subtotalEl.value = formatRupiah(subtotal);
							}
						}

						const total = subtotalArr.reduce((acc, curr) => acc + curr, 0);
						document.getElementById(`total_amount_${suffix}`).value = formatRupiah(total);
						basic = total;
					}
					
					let feeNominal = parseFloat(document.getElementById(`management_fee_value_${suffix}`).value) || 0;
					let feePercent = parseFloat(document.getElementById(`management_fee_percent_${suffix}`).value) || 0;
					let vatPercent = parseFloat(document.getElementById(`vat_percent_${suffix}`).value) || 0;
					let fee = getManagementFee(basic, feePercent, feeNominal);
					let sales = basic + fee;
					let vat = sales * (vatPercent / 100);
					let invoice = sales + vat;

					if (BOQ_TYPE === 'B') {
						document.getElementById(`basic_price_${suffix}`).value = formatRupiah(basic);
					}
					document.getElementById(`sales_amount_${suffix}`).value = formatRupiah(sales);
					document.getElementById(`vat_amount_${suffix}`).value = formatRupiah(vat);
					document.getElementById(`invoice_amount_${suffix}`).value = formatRupiah(invoice);
				}

				function resetFields() {
					const suffix = BOQ_TYPE.toLowerCase();
					let inputFields = [
						`description_${suffix}`,
						`management_fee_value_${suffix}`,
						`management_fee_percent_${suffix}`,
						`sales_amount_${suffix}`,
						`vat_amount_${suffix}`,
						`invoice_amount_${suffix}`
					];

					if (BOQ_TYPE === "A") {
						inputFields = inputFields.concat(`basic_price_${suffix}`); 
					} else if (BOQ_TYPE === "B") {
						inputFields = inputFields.concat([
							`basic_price_${suffix}`,
							'qty_adult',
							'price_adult',
							'qty_child',
							'price_child',
							'qty_infant',
							'price_infant',
							'basic_price_b',
						])
					} else if (BOQ_TYPE === "C") {
						C_ROW_COUNT = 0;
						C_ROW_ARR = [];
						document.querySelector("#form_type_c #products_services_body_c").innerHTML = '';
					} else if (BOQ_TYPE === "D") {
						D_ROW_COUNT = 0;
						D_ROW_ARR = [];
						document.querySelector("#form_type_d #products_services_body_d").innerHTML = '';
					}
					
					inputFields.forEach(id => {
						const el = document.getElementById(id);
						if (el) el.value = '';
					});
					
					const vatEl = document.getElementById(`vat_percent_${suffix}`);
					if(vatEl) vatEl.value = '1';
				}

				// ✅ Ambil data per type
				function getBOQData(type) {
					const suffix = type.toLowerCase();
					return {
						description: document.querySelector(`[name="description_${suffix}"]`)?.value.trim(),
						basic_price: parseFloat(document.getElementById(`basic_price_${suffix}`)?.value) || 0, // only type a
						management_fee_value: parseFloat(document.getElementById(`management_fee_value_${suffix}`)?.value) || 0,
						management_fee_percent: parseFloat(document.getElementById(`management_fee_percent_${suffix}`)?.value) || 0,
						vat_percent: parseFloat(document.getElementById(`vat_percent_${suffix}`)?.value) || 0,
						sales_amount: parseFloat(document.getElementById(`sales_amount_${suffix}`)?.value.replace(/\./g, '').replace(',', '.')) || 0,
						vat_amount: parseFloat(document.getElementById(`vat_amount_${suffix}`)?.value.replace(/\./g, '').replace(',', '.')) || 0,
						invoice_amount: parseFloat(document.getElementById(`invoice_amount_${suffix}`)?.value.replace(/\./g, '').replace(',', '.')) || 0,
					};
				}

			
